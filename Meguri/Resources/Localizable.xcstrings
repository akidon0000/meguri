      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真を読み取れませんでした"
          }
        }
      }
    },
    "Create": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成"
          }
        }
      }
    },
