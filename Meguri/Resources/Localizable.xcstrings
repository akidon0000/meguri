      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅なし"
          }
        }
      }
    },
    "Nothing collected yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も集まっていません"
          }
        }
      }
    },
