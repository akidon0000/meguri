      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅に追加しない"
          }
        }
      }
    },
    "Entries with a location will show up here as pins.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報を持つエントリがここにピンで表示されます。"
          }
        }
      }
    },
    "Finding out what it is…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調べています…"
          }
        }
      }
    },
    "Looking at the photo…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を見ています…"
          }
        }
      }
    },
