      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他"
          }
        }
      }
    },
    "Other trips": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の旅"
          }
        }
      }
    },
    "Places": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所"
          }
        }
      }
    },
    "Point at a painting, a building, or a view. Meguri explains what it is and keeps it here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵画や建物、景色にカメラを向けてください。何なのかを説明して、ここに記録していきます。"
          }
        }
      }
    },
    "Rename trip": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅の名前を変更"
          }
        }
      }
    },
    "Sculpture": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彫刻"
          }
        }
      }
    },
    "Start a new trip: \"%@\"": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい旅にする：「%@」"
          }
        }
      }
    },
    "Streetscape": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "街並み"
          }
        }
      }
    },
    "Take Photo": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を撮る"
          }
        }
      }
    },
    "Take your first photo": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の一枚を撮ろう"
          }
        }
      }
    },
    "The model couldn't produce an explanation this time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回は説明を生成できませんでした。"
          }
        }
      }
    },
    "The model declined to describe this photo.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真の説明は生成できない内容と判断されました。"
          }
        }
      }
    },
    "The on-device model is still downloading. Try again in a while.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルをまだダウンロード中です。しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "This device does not support Apple Intelligence.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末は Apple Intelligence に対応していません。"
          }
        }
      }
    },
    "Too many requests right now. Try again in a moment.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが混み合っています。少し待ってからもう一度お試しください。"
          }
        }
      }
    },
    "Trips": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅"
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度"
          }
        }
      }
    },
