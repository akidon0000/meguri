        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明な場所"
          }
        }
      }
    },
    "Untitled": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無題"
          }
        }
      }
    },
    "Your language isn't supported by the on-device model yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語はまだオンデバイスモデルに対応していません。"
